{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emergency Delivery",
  "version": "1.1.6",
  "identifier": "com.emergencydelivery.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Emergency Delivery",
        "width": 900,
        "height": 668,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost blob:; connect-src 'self' ipc: http://ipc.localhost https://emergency-delivery-dispatch.opinionplus.workers.dev wss://emergency-delivery-dispatch.opinionplus.workers.dev; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets":  "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFMkZGQzhFMTA0OTY2QzgKUldUSVpra1Fqdnd2Zml5Z0RKcWg1TFFCQnRiWEJ4eFRScXFra1c0U0Q2Q2xkcS85ZzJhVStWb3MK",
      "endpoints": [
        "https://github.com/ghostwipe-png/Emergency-Delivery/releases/latest/download/latest.json"
      ]
    }
  }
}